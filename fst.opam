# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Native OCaml FST waveform reader and FST to VCD converter"
description:
  "Reads FST, the compressed waveform format of GTKWave written by Verilator and other simulators, and converts it to VCD byte-for-byte as libfst's fst2vcd does. zlib, gzip, LZ4 and FastLZ sections are decoded in OCaml, without C stubs."
maintainer: ["Vladimir Silyaev"]
authors: ["Vladimir Silyaev"]
license: "MIT"
homepage: "https://github.com/TheCBaH/ocaml-fst"
bug-reports: "https://github.com/TheCBaH/ocaml-fst/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "4.14"}
  "zipc" {>= "0.2.0"}
  "unlz4"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/TheCBaH/ocaml-fst.git"
x-maintenance-intent: ["(latest)"]
x-ai-disclosure: "ai-generated"
x-ai-provider: "Anthropic, OpenAI"
# zipc's zlib_decompress ~start fix (dbuenzli/zipc#10) is not released yet.
pin-depends: [
  ["zipc.dev" "git+https://github.com/dbuenzli/zipc.git#076e6168a222dfe46b7ba598dc87a9a2e58b2569"]
  ["unlz4.dev" "git+https://github.com/TheCBaH/ocaml-unlz4.git#f5446abf9a4ce4beb92b02ee958f345a6c8171bd"]
]
